# Copie para apps/api/.env e preencha. Validado com Zod no boot.
API_PORT=3333
# A única origem liberada no CORS: a do front.
CORS_ORIGIN=http://localhost:3000
# Fica só no servidor; nunca chega ao navegador.
ANTHROPIC_API_KEY=
# O modelo da Claude de cada papel.
CHARACTER_MODEL=claude-sonnet-5-5
OBJECTIVE_CHECKER_MODEL=claude-haiku-4-5
EVALUATOR_MODEL=claude-sonnet-5-5
